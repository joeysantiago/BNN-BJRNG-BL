{
  "DatabaseProvider": {
    "UseLocalServer": true,
    "UseAzureSqlServer": false
  },
  "ConnectionStrings": {
    "MSSQLServer": "Server=<sql-server-host>;Database=thakurg-meta;User ID=<user>;Password=<password>;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "AzureSQLConnection": "Server=tcp:<your-server>.database.windows.net,1433;Database=thakurg-meta;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60"
  },
  "Cors": {
    "AllowedOrigins": [ "https://uat.thakurg.com" ]
  },
  "Site": {
    "PublicUrl": "https://uat.thakurg.com"
  },
  "Email": {
    "Smtp": { "Host": "<smtp-host>", "Port": 587, "UseSsl": true, "ImplicitTls": false, "User": "<smtp-user>", "Password": "<smtp-password>", "FromAddress": "<no-reply@your-domain>" }
  },
  "Auth": {
    "Otp": {
      "Apps": [ "khata", "tracker" ],
      "CodeLength": 6,
      "CodeMinutes": 10,
      "MaxAttempts": 5,
      "ResendSeconds": 60,
      "MaxPerDestination": 5,
      "DestinationWindowMinutes": 60,
      "MaxPerDestinationPerDay": 10,
      "LockAfterFailedCodes": 3,
      "LockMinutes": 30,
      "IpLength": 45,
      "PhoneEmailDomain": "mobile.invalid"
    }
  },
  "Profile": {
    "Limits": { "AddressLength": 200, "CityLength": 100, "StateLength": 100, "PostalCodeLength": 20, "CountryLength": 100, "MobileLength": 20, "CompanyNameLength": 150, "CompanyTaxIdLength": 30, "CompanyEmailLength": 256, "CompanyPhoneLength": 20, "CompanyAddressLength": 500 }
  },
  "Export": {
    "PdfMargin": 24,
    "PdfFontSize": 9,
    "PdfTitleFontSize": 14,
    "PdfCellPadding": 4,
    "PdfLineWidth": 0.5,
    "SheetNameLength": 31
  },
  "MusicStorage": {
    "Root": "App-Data"
  },
  "Khata": {
    "Limits": { "NoteLength": 500, "BookNameLength": 100, "ContactNameLength": 100, "ContactAddressLength": 300, "PhotoFileNameLength": 260, "MaxContactPhotoBytes": 524288, "MultipartOverheadBytes": 65536, "FirstEntryDate": "2000-01-01" },
    "Storage": { "MaxRetries": 2, "NetworkTimeoutSeconds": 30, "SecretLength": 2000, "BlobFolder": "khata", "EndpointSuffix": "core.windows.net" },
    "Notifications": { "QueueCapacity": 1000, "ErrorLength": 500 },
    "Manifest": {
      "CacheSeconds": 3600,
      "Id": "/khata-app",
      "StartUrl": "/?source=khata-pwa#/khata/app",
      "Scope": "/",
      "Display": "standalone",
      "Orientation": "portrait",
      "BackgroundColor": "#eef1f7",
      "ThemeColor": "#2f5bea",
      "Icons": [
        { "Src": "/icons/khata-192.png", "Sizes": "192x192", "Type": "image/png", "Purpose": "any" },
        { "Src": "/icons/khata-512.png", "Sizes": "512x512", "Type": "image/png", "Purpose": "any" },
        { "Src": "/icons/khata-maskable-512.png", "Sizes": "512x512", "Type": "image/png", "Purpose": "maskable" }
      ]
    },
    "LocalFiles": { "Root": "App-Data/khata" }
  },
  "Avatars": {
    "Root": "App-Data/avatars"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
