{
  "DatabaseProvider": {
    "UseLocalServer": true,
    "UseAzureSqlServer": false
  },
  "ConnectionStrings": {
    "MSSQLServer": "Server=(localdb)\\MSSQLLocalDB;Database=thakurg-meta;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "AzureSQLConnection": "Server=tcp:<your-server>.database.windows.net,1433;Database=thakurg-meta;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "https://localhost:4200" ]
  },
  "Proxy": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimiting": {
    "WindowSeconds": 60,
    "GlobalPermitLimit": 600,
    "StreamPermitLimit": 30,
    "SensitivePermitLimit": 10,
    "Auth": {
      "Login": { "Permit": 10, "WindowSeconds": 600 },
      "Refresh": { "Permit": 30, "WindowSeconds": 60 },
      "Otp": { "Permit": 10, "WindowSeconds": 600 }
    },
    "Khata": {
      "Write": { "Permit": 60, "WindowSeconds": 60, "Burst": 20 },
      "Read": { "Permit": 300, "WindowSeconds": 60, "Burst": 60 }
    }
  },
  "Auth": {
    "Jwt": { "Issuer": "thakurg-local", "AccessMinutes": 15, "RefreshDays": 30 },
    "AccessCookie": { "Name": "thakurg_at", "Path": "/api", "SameSite": "None" },
    "RefreshCookie": { "Name": "thakurg_rt", "Path": "/api/auth", "SameSite": "None" },
    "PasswordMinLength": 8,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "SessionCacheSeconds": 300,
    "BlockedEmailDomains": [ "yopmail.com", "mailinator.com", "guerrillamail.com", "10minutemail.com", "tempmail.com", "temp-mail.org", "trashmail.com", "sharklasers.com", "getnada.com", "dispostable.com" ],
    "Otp": {
      "Apps": [ "khata", "tracker", "tasks" ],
      "CodeLength": 6,
      "CodeMinutes": 10,
      "MaxAttempts": 5,
      "ResendSeconds": 60,
      "MaxPerDestination": 5,
      "DestinationWindowMinutes": 60,
      "MaxPerDestinationPerDay": 10,
      "LockAfterFailedCodes": 3,
      "LockMinutes": 30,
      "IpLength": 45,
      "PhoneEmailDomain": "mobile.invalid"
    }
  },
  "Site": {
    "PublicUrl": "http://localhost:4200"
  },
  "AppManifests": {
    "CacheSeconds": 3600,
    "Apps": {
      "khata": {
        "Id": "/khata-app",
        "StartUrl": "/apps/khata/?source=pwa#/khata/app",
        "Scope": "/apps/khata/",
        "Display": "standalone",
        "Orientation": "portrait",
        "BackgroundColor": "#eef1f7",
        "ThemeColor": "#2f5bea",
        "Icons": [
          { "Src": "/icons/khata-192.png", "Sizes": "192x192", "Type": "image/png", "Purpose": "any" },
          { "Src": "/icons/khata-512.png", "Sizes": "512x512", "Type": "image/png", "Purpose": "any" },
          { "Src": "/icons/khata-maskable-512.png", "Sizes": "512x512", "Type": "image/png", "Purpose": "maskable" }
        ]
      },
      "creta": {
        "Id": "/creta-app",
        "StartUrl": "/apps/creta/?source=pwa#/creta",
        "Scope": "/apps/creta/",
        "Display": "standalone",
        "Orientation": "portrait",
        "BackgroundColor": "#170a1c",
        "ThemeColor": "#d9482b",
        "Icons": [
          { "Src": "/icons/creta-192.png", "Sizes": "192x192", "Type": "image/png", "Purpose": "any" },
          { "Src": "/icons/creta-512.png", "Sizes": "512x512", "Type": "image/png", "Purpose": "any" },
          { "Src": "/icons/creta-maskable-512.png", "Sizes": "512x512", "Type": "image/png", "Purpose": "maskable" }
        ]
      },
      "nexon": {
        "Id": "/nexon-app",
        "StartUrl": "/apps/nexon/?source=pwa#/nexon",
        "Scope": "/apps/nexon/",
        "Display": "standalone",
        "Orientation": "portrait",
        "BackgroundColor": "#0b1a1f",
        "ThemeColor": "#11998e",
        "Icons": [
          { "Src": "/icons/nexon-192.png", "Sizes": "192x192", "Type": "image/png", "Purpose": "any" },
          { "Src": "/icons/nexon-512.png", "Sizes": "512x512", "Type": "image/png", "Purpose": "any" },
          { "Src": "/icons/nexon-maskable-512.png", "Sizes": "512x512", "Type": "image/png", "Purpose": "maskable" }
        ]
      },
      "youtube": {
        "Id": "/youtube-app",
        "StartUrl": "/apps/youtube/?source=pwa#/youtube",
        "Scope": "/apps/youtube/",
        "Display": "standalone",
        "Orientation": "any",
        "BackgroundColor": "#0d0d0d",
        "ThemeColor": "#e8001f",
        "Icons": [
          { "Src": "/icons/youtube-192.png", "Sizes": "192x192", "Type": "image/png", "Purpose": "any" },
          { "Src": "/icons/youtube-512.png", "Sizes": "512x512", "Type": "image/png", "Purpose": "any" },
          { "Src": "/icons/youtube-maskable-512.png", "Sizes": "512x512", "Type": "image/png", "Purpose": "maskable" }
        ]
      },
      "tasks": {
        "Id": "/tasks-app",
        "StartUrl": "/apps/tasks/?source=tasks-pwa#/tasks/app",
        "Scope": "/apps/tasks/",
        "Display": "standalone",
        "Orientation": "portrait",
        "BackgroundColor": "#eef1f7",
        "ThemeColor": "#2f5bea",
        "Icons": [
          { "Src": "/icons/tasks-192.png", "Sizes": "192x192", "Type": "image/png", "Purpose": "any" },
          { "Src": "/icons/tasks-512.png", "Sizes": "512x512", "Type": "image/png", "Purpose": "any" },
          { "Src": "/icons/tasks-maskable-512.png", "Sizes": "512x512", "Type": "image/png", "Purpose": "maskable" }
        ]
      }
    }
  },
  "Email": {
    "Smtp": { "Host": "", "Port": 587, "UseSsl": true, "ImplicitTls": false, "FromAddress": "no-reply@thakurg.com", "FromName": "Thakurg" }
  },
  "Profile": {
    "Limits": { "AddressLength": 200, "CityLength": 100, "StateLength": 100, "PostalCodeLength": 20, "CountryLength": 100, "MobileLength": 20, "CompanyNameLength": 150, "CompanyTaxIdLength": 30, "CompanyEmailLength": 256, "CompanyPhoneLength": 20, "CompanyAddressLength": 500 }
  },
  "Export": {
    "PdfMargin": 24,
    "PdfFontSize": 9,
    "PdfTitleFontSize": 14,
    "PdfCellPadding": 4,
    "PdfLineWidth": 0.5,
    "SheetNameLength": 31
  },
  "Sms": {
    "Provider": "None"
  },
  "WhatsApp": {
    "Provider": "Meta",
    "BaseUrl": "https://graph.facebook.com/",
    "TimeoutSeconds": 15
  },
  "Khata": {
    "NewUser": { "Language": "en", "TimeZone": "Asia/Kolkata", "DailySummaryTime": "21:00", "NotificationsEnabled": true },
    "Limits": { "MaxBooks": 20, "MaxCustomCurrencies": 20, "MaxContactsPerBook": 5000, "MaxAmountMinor": 100000000000000, "PageSize": 50, "MaxPageSize": 200, "IdempotencyHours": 24, "MaxPhotosPerEntry": 3, "MaxPhotoBytes": 2097152, "SummaryMonths": 6, "SummaryTopContacts": 5, "SummaryRecent": 6, "MaxExportRows": 5000, "NoteLength": 500, "BookNameLength": 100, "ContactNameLength": 100, "ContactAddressLength": 300, "PhotoFileNameLength": 260, "MaxContactPhotoBytes": 524288, "MultipartOverheadBytes": 65536, "FirstEntryDate": "2000-01-01" },
    "Storage": { "MaxRetries": 2, "NetworkTimeoutSeconds": 30, "SecretLength": 2000, "BlobFolder": "khata", "EndpointSuffix": "core.windows.net" },
    "Notifications": { "QueueCapacity": 1000, "ErrorLength": 500 },
    "Pin": { "Length": 4, "MaxAttempts": 5, "LockMinutes": 15, "MaxFailures": 10, "ResetMinutes": 10, "LockAfterMinutes": 5, "RenewSeconds": 60 },
    "LocalFiles": { "Root": "../../../App-Data/khata" }
  },
  "Tasks": {
    "LocalFiles": { "Root": "../../../App-Data/tasks" },
    "Reminders": { "IntervalSeconds": 300, "UpcomingDays": 3 },
    "Pin": { "Length": 4, "MaxAttempts": 5, "LockMinutes": 15, "MaxFailures": 10, "ResetMinutes": 10, "RenewSeconds": 60 },
    "NewUser": {
      "LockAfterMinutes": 5,
      "NotificationsEnabled": true,
      "ReminderTime": "09:00",
      "RemindBefore": "1d",
      "OverdueReminders": true,
      "UpcomingReminders": true,
      "WeekStart": "mon",
      "DefaultTab": "active",
      "DefaultPriority": 2,
      "DefaultCategoryCode": "personal",
      "WhatsAppReminders": false,
      "TimeZone": "Asia/Kolkata",
      "Categories": [
        { "Code": "marketing", "Name": "Marketing", "Color": "#d6489a", "IsSystem": true },
        { "Code": "personal", "Name": "Personal", "Color": "#3a66f5", "IsSystem": false },
        { "Code": "home", "Name": "Home", "Color": "#1f9d63", "IsSystem": false },
        { "Code": "maintenance", "Name": "Maintenance", "Color": "#f5a524", "IsSystem": false },
        { "Code": "work", "Name": "Work", "Color": "#8b5cf6", "IsSystem": false }
      ]
    }
  },
  "Avatars": {
    "Folder": "avatars",
    "MaxBytes": 2097152,
    "Extensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
  },
  "FileStorage": {
    "LocalRoot": "../../../App-Data",
    "ContainerName": "app-data",
    "EnvironmentFolder": "dev",
    "ConnectionStringName": "AzureStorageConnectionString",
    "MaxRetries": 2,
    "NetworkTimeoutSeconds": 100,
    "CacheSeconds": 30
  },
  "Streaming": {
    "PacketBytes": 524288
  },
  "SpeedTest": {
    "MaxDownloadBytes": 100000000
  },
  "MusicStorage": {
    "CacheMinutes": 10,
    "CoverExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AudioExtensions": [ ".mp3", ".m4a", ".aac", ".ogg", ".oga", ".opus", ".wav", ".flac", ".weba" ]
  },
  "Hosting": {
    "HostedOn": "Local"
  },
  "YouTube": {
    "FfmpegPath": "ffmpeg",
    "AzureFfmpegPath": "",
    "MaxResults": 20,
    "StreamCacheMinutes": 20
  },
  "Tracker": {
    "CurrencyCode": "INR",
    "TimeZone": "Asia/Kolkata",
    "NewUser": { "ApprovalMode": "smart", "AutoApprovePercent": 85, "PushEnabled": true, "AlertTypes": [ "newTx", "categorized", "verify", "duplicate", "revoked", "paused", "sync" ] },
    "Limits": { "DuplicateMinutes": 10, "MaxSmsLength": 1000, "MaxImportBatch": 200, "MerchantLength": 60, "NoteLength": 300, "MaxAmountMinor": 10000000000, "MaxAlerts": 60, "MinAutoApprovePercent": 50, "MaxAutoApprovePercent": 99 },
    "Categories": [ "food", "groceries", "shopping", "transport", "fuel", "bills", "entertainment", "health", "travel", "rent", "cash", "investment", "salary", "transfer", "refund", "other" ],
