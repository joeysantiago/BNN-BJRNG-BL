      "CodeMinutes": 10,
      "MaxAttempts": 5,
      "ResendSeconds": 60,
      "MaxPerDestination": 5,
      "DestinationWindowMinutes": 60,
      "MaxPerDestinationPerDay": 10,
      "LockAfterFailedCodes": 3,
      "LockMinutes": 30,
      "IpLength": 45,
