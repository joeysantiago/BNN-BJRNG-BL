{
  "DatabaseProvider": {
    "UseLocalServer": true,
    "UseAzureSqlServer": false
  },
  "ConnectionStrings": {
    "MSSQLServer": "Server=(localdb)\\MSSQLLocalDB;Database=Thakurg-MetaData;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "AzureSQLConnection": "Server=tcp:<your-server>.database.windows.net,1433;Database=Thakurg-MetaData;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "https://localhost:4200" ]
  },
  "Streaming": {
    "PacketBytes": 524288
  },
  "SpeedTest": {
    "MaxDownloadBytes": 100000000
  },
  "MusicStorage": {
    "Root": "../../../App-Data"
  },
  "YouTube": {
    "FfmpegPath": "ffmpeg",
    "MaxResults": 20,
    "StreamCacheMinutes": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
