{
  "DatabaseProvider": {
    "UseLocalServer": true,
    "UseAzureSqlServer": false
  },
  "ConnectionStrings": {
    "MSSQLServer": "Server=(localdb)\\MSSQLLocalDB;Database=thakurg-meta;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "AzureSQLConnection": "Server=tcp:<your-server>.database.windows.net,1433;Database=thakurg-meta;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "https://localhost:4200" ]
  },
  "Site": {
    "PublicUrl": "http://localhost:4200"
  },
  "AppManifests": {
    "CacheSeconds": 3600,
    "Apps": {
      "youtube": {
        "Id": "/youtube-app",
        "StartUrl": "/apps/youtube/?source=pwa#/youtube",
        "Scope": "/apps/youtube/",
        "Display": "standalone",
        "Orientation": "any",
        "BackgroundColor": "#0d0d0d",
        "ThemeColor": "#e8001f",
        "Icons": [
          { "Src": "/icons/youtube-192.png", "Sizes": "192x192", "Type": "image/png", "Purpose": "any" },
          { "Src": "/icons/youtube-512.png", "Sizes": "512x512", "Type": "image/png", "Purpose": "any" },
          { "Src": "/icons/youtube-maskable-512.png", "Sizes": "512x512", "Type": "image/png", "Purpose": "maskable" }
        ]
      }
    }
  },
  "Proxy": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimiting": {
    "WindowSeconds": 60,
    "GlobalPermitLimit": 600,
    "StreamPermitLimit": 30,
    "SensitivePermitLimit": 10,
    "Auth": {
      "Login": { "Permit": 10, "WindowSeconds": 600 },
      "Refresh": { "Permit": 30, "WindowSeconds": 60 }
    },
    "Khata": {
      "Write": { "Permit": 60, "WindowSeconds": 60, "Burst": 20 },
      "Read": { "Permit": 300, "WindowSeconds": 60, "Burst": 60 }
    }
  },
  "Auth": {
    "Jwt": { "Issuer": "thakurg-local", "AccessMinutes": 15, "RefreshDays": 30 },
    "AccessCookie": { "Name": "thakurg_at", "Path": "/api", "SameSite": "None" },
    "RefreshCookie": { "Name": "thakurg_rt", "Path": "/api/auth", "SameSite": "None" },
    "PasswordMinLength": 8,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "SessionCacheSeconds": 300,
    "AdminEmails": []
  },
  "Khata": {
    "NewUser": { "Language": "en", "TimeZone": "Asia/Kolkata", "DailySummaryTime": "21:00" },
    "Limits": { "MaxBooks": 20, "MaxCustomCurrencies": 20, "MaxContactsPerBook": 5000, "MaxAmountMinor": 100000000000000, "PageSize": 50, "MaxPageSize": 200, "IdempotencyHours": 24 }
  },
  "Avatars": {
    "Root": "../../../App-Data/avatars",
    "MaxBytes": 2097152,
    "Extensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
  },
  "Streaming": {
    "PacketBytes": 524288
  },
  "SpeedTest": {
    "MaxDownloadBytes": 100000000
  },
  "MusicStorage": {
    "Root": "../../../App-Data",
    "CacheMinutes": 10,
    "CoverExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AudioExtensions": [ ".mp3", ".m4a", ".aac", ".ogg", ".oga", ".opus", ".wav", ".flac", ".weba" ]
  },
  "Hosting": {
    "HostedOn": "Local"
  },
  "YouTube": {
    "FfmpegPath": "ffmpeg",
    "AzureFfmpegPath": "",
    "MaxResults": 20,
    "StreamCacheMinutes": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
