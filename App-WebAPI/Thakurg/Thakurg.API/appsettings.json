{
  "DatabaseProvider": {
    "UseLocalServer": true,
    "UseAzureSqlServer": false
  },
  "ConnectionStrings": {
    "MSSQLServer": "Server=(localdb)\\MSSQLLocalDB;Database=thakurg-meta;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "AzureSQLConnection": "Server=tcp:<your-server>.database.windows.net,1433;Database=thakurg-meta;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "https://localhost:4200" ]
  },
  "Proxy": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimiting": {
    "WindowSeconds": 60,
    "GlobalPermitLimit": 600,
    "StreamPermitLimit": 30,
    "SensitivePermitLimit": 10,
    "Khata": {
      "OtpSend": { "Permit": 5, "WindowSeconds": 600 },
      "OtpVerify": { "Permit": 10, "WindowSeconds": 600 },
      "Refresh": { "Permit": 30, "WindowSeconds": 60 },
      "Pin": { "Permit": 10, "WindowSeconds": 60 },
      "Write": { "Permit": 60, "WindowSeconds": 60, "Burst": 20 },
      "Read": { "Permit": 300, "WindowSeconds": 60, "Burst": 60 }
    }
  },
  "Khata": {
    "Jwt": { "Issuer": "thakurg-local", "AccessMinutes": 15, "RefreshDays": 30 },
    "Otp": { "Sender": "Dev", "ExpiryMinutes": 5, "MaxAttempts": 5, "CooldownSeconds": 45, "PerTenMinutes": 3, "PerDay": 10 },
    "Pin": { "MinLength": 4, "MaxLength": 6, "MaxTries": 5, "LockoutMinutes": 15, "ResetAfterTries": 10, "ProofSeconds": 120, "FreshLoginMinutes": 10 },
    "RefreshCookie": { "Name": "khata_rt", "Path": "/api/khata/auth", "SameSite": "None" },
    "NewUser": { "Language": "en", "TimeZone": "Asia/Kolkata", "DailySummaryTime": "21:00" },
    "Limits": { "MaxBooks": 20, "MaxCustomCurrencies": 20, "MaxContactsPerBook": 5000, "MaxAmountMinor": 100000000000000, "PageSize": 50, "MaxPageSize": 200, "IdempotencyHours": 24 }
  },
  "Streaming": {
    "PacketBytes": 524288
  },
  "SpeedTest": {
    "MaxDownloadBytes": 100000000
  },
  "MusicStorage": {
    "Root": "../../../App-Data",
    "CoverExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AudioExtensions": [ ".mp3", ".m4a", ".aac", ".ogg", ".oga", ".opus", ".wav", ".flac", ".weba" ]
  },
  "Hosting": {
    "HostedOn": "Local"
  },
  "YouTube": {
    "FfmpegPath": "ffmpeg",
    "AzureFfmpegPath": "",
    "MaxResults": 20,
    "StreamCacheMinutes": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
