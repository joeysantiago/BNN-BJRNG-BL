{
  "DatabaseProvider": {
    "UseLocalServer": true,
    "UseAzureSqlServer": false
  },
  "ConnectionStrings": {
    "MSSQLServer": "Server=<sql-server-host>;Database=Thakurg-MetaData;User ID=<user>;Password=<password>;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "AzureSQLConnection": "Server=tcp:<your-server>.database.windows.net,1433;Database=Thakurg-MetaData;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60"
  },
  "Cors": {
    "AllowedOrigins": [ "https://thakurg.com", "https://www.thakurg.com" ]
  },
  "MusicStorage": {
    "Root": "App-Data"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
